---
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <!-- 顶部分割线（渐变） -->
  <div class="footer-divider" aria-hidden="true"></div>

  <div class="container">
    <div class="footer-inner">
      <!-- 左侧 Logo + 简介 -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Product Stories 首页">
          <div class="footer-logo-mark" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </div>
          <span class="footer-logo-text">Product Stories</span>
        </a>
        <p class="footer-tagline">
          探索改变世界的产品背后的故事——<br class="footer-br" />
          记录每一个关键决策与转折时刻。
        </p>
        <!-- RSS 订阅 -->
        <a href="/rss.xml" class="footer-rss" target="_blank" rel="noopener" title="订阅 RSS">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9"/>
            <path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1"/>
          </svg>
          RSS 订阅
        </a>
      </div>

      <!-- 右侧导航 -->
      <div class="footer-right">
        <nav class="footer-nav" aria-label="页脚导航">
          <span class="footer-nav-label">导航</span>
          <a href="/" class="footer-link">首页</a>
          <a href="/stories" class="footer-link">故事库</a>
          <a href="/sitemap-index.xml" class="footer-link" target="_blank">Sitemap</a>
        </nav>
      </div>
    </div>

    <!-- 底部版权栏 -->
    <div class="footer-bottom">
      <p class="footer-copy">
        © {currentYear} Product Stories · 用心记录产品的故事
      </p>
      <p class="footer-made">
        持续更新中
        <span class="footer-dot" aria-hidden="true"></span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    position: relative;
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-default) 20%, var(--border-default) 80%, transparent);
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
    padding: 48px 0 32px;
    flex-wrap: wrap;
  }

  /* ═══ 品牌区 ═══ */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 280px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .footer-logo:hover {
    opacity: 0.75;
  }

  .footer-logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-accent) 100%);
    color: #fff;
    border-radius: var(--radius-md);
    box-shadow: 0 2px 6px rgba(194, 98, 10, 0.25);
    flex-shrink: 0;
  }

  .dark .footer-logo-mark {
    background: linear-gradient(135deg, var(--color-brand-dark) 0%, var(--color-brand-accent) 100%);
  }

  .footer-logo-text {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .footer-br {
    display: none;
  }

  @media (min-width: 600px) {
    .footer-br {
      display: block;
    }
  }

  .footer-rss {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: var(--color-brand-muted);
    border: 1px solid rgba(194, 98, 10, 0.15);
    transition: all var(--transition-fast);
    width: fit-content;
  }

  .footer-rss:hover {
    background: var(--color-brand);
    color: #fff;
    border-color: var(--color-brand);
  }

  .dark .footer-rss {
    color: var(--color-brand-accent);
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.2);
  }

  .dark .footer-rss:hover {
    background: var(--color-brand-accent);
    color: #1a1614;
    border-color: var(--color-brand-accent);
  }

  /* ═══ 导航区 ═══ */
  .footer-right {
    display: flex;
    gap: 48px;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-nav-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .footer-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-brand);
  }

  .dark .footer-link:hover {
    color: var(--color-brand-accent);
  }

  /* ═══ 底部版权栏 ═══ */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .footer-made {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .footer-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulse-warm 2s ease-in-out infinite;
  }

  /* ═══ 响应式 ═══ */
  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      gap: 32px;
      padding: 36px 0 24px;
    }

    .footer-brand {
      max-width: 100%;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
