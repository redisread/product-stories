---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StoryCard from '../components/StoryCard.astro';
import { countTags, getUniqueProducts } from '../utils/helpers';

const allStories = (await getCollection('stories', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const featuredStories = allStories.filter((s) => s.data.featured).slice(0, 3);
const recentStories = allStories.slice(0, 6);
const tagCounts = countTags(allStories);
const topTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 20);
const totalStories = allStories.length;
const totalProducts = getUniqueProducts(allStories).length;

// 精选产品用于 Hero 装饰展示
const heroProducts = getUniqueProducts(allStories).slice(0, 8);
---

<BaseLayout
  title="Product Stories"
  description="探索改变世界的产品背后的故事——从创意诞生到用户爱上它的每一个关键时刻。"
>
  <Navbar />

  <main id="main-content">
    <!-- ═══════════════════════════════════
         HERO SECTION
         Visual Designer: 沉浸式渐变 + 装饰性噪点纹理
         Interaction Designer: 入场动画序列
         ═══════════════════════════════════ -->
    <section class="hero" aria-label="页面介绍">
      <!-- 背景装饰层 -->
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-glow hero-glow--1"></div>
        <div class="hero-glow hero-glow--2"></div>
        <div class="hero-glow hero-glow--3"></div>
        <div class="hero-noise"></div>
        <!-- 浮动装饰圆点 -->
        <div class="hero-dots">
          {Array.from({ length: 6 }).map((_, i) => <div class={`hero-dot hero-dot--${i + 1}`} />)}
        </div>
      </div>

      <div class="container hero-inner">
        <!-- 状态标签 -->
        <div class="hero-badge animate-fade-in">
          <span class="hero-badge-pulse" aria-hidden="true"></span>
          <span>持续更新中</span>
          <span class="hero-badge-sep" aria-hidden="true">·</span>
          <span class="hero-badge-count">{totalStories} 个故事</span>
        </div>

        <!-- 主标题 -->
        <h1 class="hero-title animate-fade-in-up delay-100">
          每个伟大产品
          <br />
          <span class="hero-title-highlight">
            背后都有一个故事
            <span class="hero-title-underline" aria-hidden="true"></span>
          </span>
        </h1>

        <!-- 副标题 -->
        <p class="hero-desc animate-fade-in-up delay-200">
          从 Uber 的巴黎雪夜，到 Discord 的意外转型，到 Spotify 的海盗灵感—— 探索 <strong
            >{totalStories}</strong
          > 个改变世界的产品诞生故事。
        </p>

        <!-- CTA 按钮组 -->
        <div class="hero-actions animate-fade-in-up delay-300">
          <a href="/stories" class="btn-primary">
            <span>浏览全部故事</span>
            <svg
              class="btn-arrow"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 8H13M13 8L9 4M13 8L9 12"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="#recent" class="btn-ghost">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            最新发布
          </a>
        </div>

        <!-- 统计数字 -->
        <div class="hero-stats animate-fade-in-up delay-400">
          <div class="stat-item">
            <span class="stat-number" data-count={totalStories}>{totalStories}</span>
            <span class="stat-label">个产品故事</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number" data-count={totalProducts}>{totalProducts}</span>
            <span class="stat-label">个知名产品</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number">{topTags.length}+</span>
            <span class="stat-label">个主题标签</span>
          </div>
        </div>

        <!-- 产品 Logo 滚动展示 -->
        {
          heroProducts.length > 0 && (
            <div class="hero-products animate-fade-in delay-500" aria-label="收录产品">
              <span class="hero-products-label">已收录</span>
              <div class="hero-products-track">
                {heroProducts.map((p) => (
                  <span class="hero-product-chip">{p}</span>
                ))}
                {heroProducts.length > 5 && (
                  <span class="hero-product-more">+{totalProducts - heroProducts.length} 更多</span>
                )}
              </div>
            </div>
          )
        }
      </div>

      <!-- 向下滚动指示 -->
      <a href="#featured" class="hero-scroll-hint animate-fade-in delay-500" aria-label="向下滚动">
        <div class="hero-scroll-icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12l7 7 7-7"></path>
          </svg>
        </div>
      </a>
    </section>

    <!-- ═══════════════════════════════════
         精选故事
         Visual Designer: 不对称网格布局，突出第一篇
         ═══════════════════════════════════ -->
    {
      featuredStories.length > 0 && (
        <section class="section" id="featured">
          <div class="container">
            <div class="section-header reveal">
              <div class="section-header-left">
                <div class="section-eyebrow">
                  <span class="eyebrow-dot" aria-hidden="true" />
                  精选
                </div>
                <h2 class="section-title">值得深读的故事</h2>
                <p class="section-desc">编辑精心挑选的产品案例与深度思考</p>
              </div>
              <a href="/stories" class="section-link">
                查看全部
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M3 8H13M13 8L9 4M13 8L9 12"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>

            <div class="featured-grid">
              {featuredStories.map((story, i) => (
                <div class={`reveal reveal-delay-${i + 1}`}>
                  <StoryCard
                    story={story}
                    variant={i === 0 ? 'featured' : 'default'}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ═══════════════════════════════════
         最新故事
         Visual Designer: 统一卡片网格，暖米色背景区分
         ═══════════════════════════════════ -->
    <section class="section section--warm" id="recent">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-header-left">
            <div class="section-eyebrow">
              <span class="eyebrow-dot eyebrow-dot--new" aria-hidden="true"></span>
              最新
            </div>
            <h2 class="section-title">最新发布</h2>
            <p class="section-desc">最近更新的产品故事</p>
          </div>
          <a href="/stories" class="section-link">
            查看全部
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8H13M13 8L9 4M13 8L9 12"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>

        <div class="cards-grid">
          {
            recentStories.map((story, i) => (
              <div class={`reveal reveal-delay-${Math.min(i + 1, 5)}`}>
                <StoryCard story={story} loading="lazy" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════
         标签云
         Interaction Designer: 悬停渐变 + 缩放动效
         Visual Designer: 大小差异体现热度
         ═══════════════════════════════════ -->
    {
      topTags.length > 0 && (
        <section class="section">
          <div class="container">
            <div class="section-header reveal">
              <div class="section-header-left">
                <div class="section-eyebrow">
                  <span class="eyebrow-dot eyebrow-dot--tag" aria-hidden="true" />
                  主题
                </div>
                <h2 class="section-title">按标签探索</h2>
                <p class="section-desc">选择你感兴趣的产品主题</p>
              </div>
            </div>

            <div class="tag-cloud reveal">
              {topTags.map(([tag, count], i) => {
                // 根据数量决定大小级别
                const maxCount = topTags[0][1];
                const ratio = count / maxCount;
                const sizeClass =
                  ratio > 0.7
                    ? 'tag--xl'
                    : ratio > 0.4
                      ? 'tag--lg'
                      : ratio > 0.2
                        ? 'tag--md'
                        : 'tag--sm';
                return (
                  <a
                    href={`/tags/${encodeURIComponent(tag)}`}
                    class={`tag-item ${sizeClass}`}
                    style={`--delay: ${i * 30}ms`}
                    title={`${count} 个故事`}
                  >
                    <span class="tag-hash" aria-hidden="true">
                      #
                    </span>
                    <span class="tag-text">{tag}</span>
                    <span class="tag-badge">{count}</span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <!-- ═══════════════════════════════════
         CTA 区域
         Visual Designer: 温暖渐变背景 + 装饰性纹理
         Interaction Designer: 按钮 shimmer 效果
         ═══════════════════════════════════ -->
    <section class="cta-section">
      <div class="cta-bg" aria-hidden="true">
        <div class="cta-glow"></div>
        <div class="cta-noise"></div>
      </div>
      <div class="container cta-inner reveal">
        <div class="cta-icon" aria-hidden="true">
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
            ></path>
          </svg>
        </div>
        <h2 class="cta-title">发现更多产品故事</h2>
        <p class="cta-desc">
          从设计决策到用户旅程，记录产品成长的每一个重要时刻。
          <br />
          每周更新，陪你探索产品世界的无限可能。
        </p>
        <div class="cta-actions">
          <a href="/stories" class="btn-cta">
            <span class="btn-cta-text">开始探索 {totalStories} 个故事</span>
            <svg
              class="btn-arrow"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 8H13M13 8L9 4M13 8L9 12"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="/rss.xml" class="btn-cta-ghost" target="_blank" rel="noopener">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
            订阅 RSS
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<!-- Interaction Designer: Intersection Observer 入场动画触发 -->
<script>
  // Reveal on scroll
  const revealElements = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  revealElements.forEach((el) => observer.observe(el));

  // 标签云入场动画
  const tagItems = document.querySelectorAll('.tag-item');
  const tagObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const delay = (entry.target as HTMLElement).style.getPropertyValue('--delay') || '0ms';
          setTimeout(() => {
            entry.target.classList.add('tag-item--visible');
          }, parseInt(delay));
          tagObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05 }
  );

  tagItems.forEach((el) => tagObserver.observe(el));
</script>

<style>
  /* ═══════════════════════════════════
     HERO
     ═══════════════════════════════════ */
  .hero {
    position: relative;
    padding: calc(var(--nav-height) + 100px) 0 80px;
    overflow: hidden;
    isolation: isolate;
  }

  /* 背景装饰 */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .hero-glow--1 {
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.2) 0%, transparent 70%);
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
  }

  .hero-glow--2 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(225, 29, 72, 0.1) 0%, transparent 70%);
    top: 100px;
    right: 10%;
    animation: float 8s ease-in-out infinite;
  }

  .hero-glow--3 {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(79, 70, 229, 0.1) 0%, transparent 70%);
    top: 50px;
    left: 5%;
    animation: float 10s ease-in-out infinite reverse;
  }

  .dark .hero-glow--1 {
    background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, transparent 70%);
    opacity: 0.7;
  }

  /* 噪点纹理 */
  .hero-noise {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    opacity: 0.4;
  }

  /* 浮动装饰点 */
  .hero-dot {
    position: absolute;
    border-radius: 50%;
    background: var(--color-brand-accent);
    opacity: 0.15;
  }

  .hero-dot--1 {
    width: 8px;
    height: 8px;
    top: 20%;
    left: 15%;
    animation: float 6s ease-in-out infinite;
  }
  .hero-dot--2 {
    width: 5px;
    height: 5px;
    top: 35%;
    left: 85%;
    animation: float 8s ease-in-out infinite 1s;
  }
  .hero-dot--3 {
    width: 12px;
    height: 12px;
    top: 60%;
    left: 8%;
    animation: float 7s ease-in-out infinite 0.5s;
    opacity: 0.1;
  }
  .hero-dot--4 {
    width: 6px;
    height: 6px;
    top: 70%;
    left: 90%;
    animation: float 9s ease-in-out infinite 2s;
  }
  .hero-dot--5 {
    width: 4px;
    height: 4px;
    top: 15%;
    left: 70%;
    animation: float 5s ease-in-out infinite 1.5s;
  }
  .hero-dot--6 {
    width: 10px;
    height: 10px;
    top: 80%;
    left: 45%;
    animation: float 11s ease-in-out infinite 0.8s;
    opacity: 0.08;
  }

  /* Hero 内容 */
  .hero-inner {
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
  }

  /* 状态标签 */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brand);
    background: var(--color-brand-muted);
    border: 1px solid rgba(194, 98, 10, 0.2);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    margin-bottom: 28px;
    letter-spacing: 0.01em;
  }

  .dark .hero-badge {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.25);
    color: var(--color-brand-accent);
  }

  .hero-badge-pulse {
    width: 7px;
    height: 7px;
    background: var(--color-brand);
    border-radius: 50%;
    animation: pulse-warm 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .dark .hero-badge-pulse {
    background: var(--color-brand-accent);
  }

  .hero-badge-sep {
    color: var(--color-brand-light);
    opacity: 0.5;
  }

  .hero-badge-count {
    opacity: 0.75;
  }

  /* 主标题 */
  .hero-title {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin-bottom: 24px;
    font-family: var(--font-display);
  }

  .hero-title-highlight {
    position: relative;
    display: inline-block;
    color: var(--color-brand);
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .dark .hero-title-highlight {
    background: linear-gradient(135deg, var(--color-brand-accent) 0%, #fde68a 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* 标题下划线装饰 */
  .hero-title-underline {
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-brand), var(--color-brand-accent), transparent);
    border-radius: var(--radius-full);
    opacity: 0.6;
  }

  /* 副标题 */
  .hero-desc {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 40px;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-desc strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* 按钮组 */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 52px;
    flex-wrap: wrap;
  }

  /* 主按钮 */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: var(--radius-lg);
    text-decoration: none;
    letter-spacing: -0.01em;
    box-shadow: var(--shadow-brand);
    transition:
      background var(--transition-fast),
      transform var(--transition-spring),
      box-shadow var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, transparent 60%);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .btn-primary:hover {
    background: var(--color-brand-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(194, 98, 10, 0.35);
  }

  .btn-primary:hover::before {
    opacity: 1;
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .dark .btn-primary {
    background: var(--color-brand-accent);
    color: #1a1614;
    box-shadow: 0 4px 16px rgba(245, 158, 11, 0.3);
  }

  .dark .btn-primary:hover {
    background: var(--color-brand-light);
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.4);
  }

  /* 箭头动画 */
  .btn-arrow {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .btn-primary:hover .btn-arrow,
  .btn-cta:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Ghost 按钮 */
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    border: 1.5px solid var(--border-default);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-spring);
  }

  .btn-ghost:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  /* 统计数字 */
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin-bottom: 36px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 900;
