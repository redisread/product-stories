---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Tag from '../components/ui/Tag.astro';
import { formatDate } from '../lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  story: CollectionEntry<'stories'>;
  product: string;
}

const { story, product } = Astro.props;
const { title, description, date, cover, author, tags, readingTime } = story.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description ?? '',
  datePublished: date.toISOString(),
  author: {
    '@type': 'Person',
    name: author ?? 'Product Stories',
  },
  image: cover,
  publisher: {
    '@type': 'Organization',
    name: 'Product Stories',
    url: Astro.site?.href ?? '',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: new URL('/', Astro.site ?? Astro.url.origin).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '故事',
      item: new URL('/stories', Astro.site ?? Astro.url.origin).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: product,
      item: new URL(
        `/stories?product=${encodeURIComponent(product)}`,
        Astro.site ?? Astro.url.origin
      ).href,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: title,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={cover}
  type="article"
  publishDate={date}
  author={author}
>
  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <!-- 阅读进度条 -->
  <div id="reading-progress" aria-hidden="true"></div>

  <Navbar />

  <main id="main-content" class="flex-1">
    <!-- 文章头部 -->
    <header class="border-b border-[var(--border)]">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
        <!-- 面包屑 -->
        <nav
          aria-label="面包屑"
          class="mb-6 flex items-center gap-2 text-sm text-[var(--muted-foreground)]"
        >
          <a href="/" class="hover:text-[var(--foreground)] transition-colors">首页</a>
          <span aria-hidden="true">/</span>
          <a href="/stories" class="hover:text-[var(--foreground)] transition-colors">故事</a>
          <span aria-hidden="true">/</span>
          <a
            href={`/stories?product=${encodeURIComponent(product)}`}
            class="hover:text-[var(--foreground)] transition-colors capitalize"
          >
            {product}
          </a>
        </nav>

        <!-- 标签 -->
        {
          tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4">
              {tags.map((tag) => (
                <Tag name={tag} />
              ))}
            </div>
          )
        }

        <!-- 标题 -->
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-4">
          {title}
        </h1>

        {
          description && (
            <p class="text-lg text-[var(--muted-foreground)] mb-6 leading-relaxed">{description}</p>
          )
        }

        <!-- 元信息 -->
        <div
          class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[var(--muted-foreground)]"
        >
          {
            author && (
              <span class="flex items-center gap-1.5">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                {author}
              </span>
            )
          }
          <time datetime={date.toISOString()} class="flex items-center gap-1.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            {formatDate(date)}
          </time>
          {
            readingTime && (
              <span class="flex items-center gap-1.5">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                {readingTime}
              </span>
            )
          }
        </div>
      </div>
    </header>

    <!-- 封面图 -->
    {
      cover && (
        <div class="max-w-3xl mx-auto px-4 sm:px-6 -mt-0">
          <img
            src={cover}
            alt={title}
            width={800}
            height={400}
            loading="eager"
            decoding="async"
            class="w-full h-56 sm:h-72 object-cover rounded-xl border border-[var(--border)] mt-8"
          />
        </div>
      )
    }

    <!-- 文章正文 -->
    <article
      class="max-w-3xl mx-auto px-4 sm:px-6 py-10 prose prose-neutral dark:prose-invert max-w-none"
      id="article-content"
    >
      <slot />
    </article>

    <!-- 底部导航 -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 pb-12">
      <div class="border-t border-[var(--border)] pt-8">
        <a
          href="/stories"
          class="inline-flex items-center gap-2 text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          返回所有故事
        </a>
      </div>
    </div>
  </main>

  <Footer />

  <!-- 阅读进度脚本 -->
  <script>
    const bar = document.getElementById('reading-progress');
    const article = document.getElementById('article-content');
    if (bar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = article.offsetHeight - window.innerHeight;
        const scrolled = Math.max(0, -rect.top);
        const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
        bar.style.width = pct + '%';
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  </script>
</BaseLayout>
