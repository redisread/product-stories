---
// 阅读进度条组件（Islands 模式，client-side）
interface Props {
  readingTime?: string;
}

const { readingTime } = Astro.props;

// 解析阅读时间（格式："X min read"），不足 1 分钟则不渲染进度条
const readingMinutes = readingTime ? parseFloat(readingTime) || 0 : 0;
const shouldRender = readingMinutes >= 1;
---

{
  shouldRender && (
    <div
      id="reading-progress"
      role="progressbar"
      aria-label="阅读进度"
      aria-valuenow="0"
      aria-valuemin="0"
      aria-valuemax="100"
    />
  )
}

<script>
  const progressBar = document.getElementById('reading-progress') as HTMLElement;

  if (progressBar) {
    const updateProgress = () => {
      const article = document.getElementById('story-content');
      if (!article) return;

      const articleTop = article.offsetTop;
      const articleHeight = article.offsetHeight;
      const windowHeight = window.innerHeight;
      const scrolled = window.scrollY;

      // 总可滚动距离：至少为 1px，避免文章短于视口时除零
      const total = Math.max(articleHeight - windowHeight, 1);
      const rawProgress = ((scrolled - articleTop) / total) * 100;

      // 文章短于视口时，只要滚过文章顶部即视为完成
      const progress =
        articleHeight <= windowHeight
          ? scrolled >= articleTop
            ? 100
            : 0
          : Math.min(Math.max(rawProgress, 0), 100);

      progressBar.style.width = `${progress}%`;
      progressBar.setAttribute('aria-valuenow', String(Math.round(progress)));
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }
</script>
