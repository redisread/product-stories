---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-sm text-[var(--muted-foreground)]">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="text-[var(--accent)]"
        >
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
        </svg>
        <span>© {year} Product Stories</span>
      </div>
      <nav aria-label="页脚导航" class="flex items-center gap-4 text-sm text-[var(--muted-foreground)]">
        <a href="/" class="hover:text-[var(--foreground)] transition-colors">首页</a>
        <a href="/stories" class="hover:text-[var(--foreground)] transition-colors">全部故事</a>
        <a href="/rss.xml" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9"/>
            <path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1"/>
          </svg>
          RSS
        </a>
      </nav>
    </div>
  </div>
</footer>
