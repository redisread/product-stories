---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { formatDate, getRelativeTime } from '../utils/helpers';

interface Props {
  story: CollectionEntry<'stories'>;
  variant?: 'default' | 'featured' | 'compact' | 'horizontal';
  loading?: 'lazy' | 'eager';
}

const { story, variant = 'default', loading = 'lazy' } = Astro.props;
const { data } = story;
const { title, description, date, readingTime, cover, tags = [], featured, products = [] } = data;

const storyUrl = `/stories/${story.id}`;

const isCompact = variant === 'compact';

// 为无封面卡片生成渐变色（基于产品名哈希）
const productName = products[0] || title;
const gradients = [
  'from-amber-100 to-orange-100',
  'from-rose-100 to-pink-100',
  'from-violet-100 to-indigo-100',
  'from-emerald-100 to-teal-100',
  'from-sky-100 to-blue-100',
  'from-yellow-100 to-amber-100',
];
const gradientIndex = productName.charCodeAt(0) % gradients.length;
const darkGradients = [
  'rgba(120,53,15,0.3)',
  'rgba(136,19,55,0.3)',
  'rgba(67,56,202,0.3)',
  'rgba(6,78,59,0.3)',
  'rgba(7,89,133,0.3)',
  'rgba(113,63,18,0.3)',
];
const placeholderColor = darkGradients[gradientIndex];
---

<article class={`story-card story-card--${variant}`}>
  <a href={storyUrl} class="story-card-link" aria-label={`阅读故事：${title}`}>
    <!-- 封面图区域 -->
    {
      !isCompact && (
        <div class="story-card-cover">
          {cover ? (
            <img
              src={cover}
              alt={title}
              loading={loading}
              decoding="async"
              class="story-card-cover-img"
            />
          ) : (
            <div
              class="story-card-cover-placeholder"
              style={`--placeholder-color: ${placeholderColor}`}
              aria-hidden="true"
            >
              {/* 装饰性背景图案 */}
              <div class="placeholder-pattern" aria-hidden="true" />
              <span class="placeholder-letter">{products[0]?.charAt(0) || title.charAt(0)}</span>
            </div>
          )}

          {/* 精选标签 */}
          {featured && (
            <div class="story-card-badge">
              <span class="featured-badge">
                <svg
                  width="10"
                  height="10"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                精选
              </span>
            </div>
          )}

          {/* 悬停时显示的渐变遮罩 */}
          <div class="cover-overlay" aria-hidden="true" />
        </div>
      )
    }

    <!-- 内容区 -->
    <div class="story-card-body">
      <!-- 产品标签 -->
      {
        !isCompact && products.length > 0 && (
          <div class="story-card-products">
            {products.slice(0, 2).map((p) => (
              <span class="story-product-label">{p}</span>
            ))}
          </div>
        )
      }

      <!-- 标题 -->
      <h3 class="story-card-title">{title}</h3>

      <!-- 描述 -->
      {!isCompact && description && <p class="story-card-desc">{description}</p>}

      <!-- 底部元信息行 -->
      <div class="story-card-footer">
        <div class="story-card-meta">
          <time datetime={date.toISOString()} class="meta-date" title={formatDate(date)}>
            {getRelativeTime(date)}
          </time>

          {
            readingTime && (
              <>
                <span class="meta-sep" aria-hidden="true">
                  ·
                </span>
                <span class="meta-reading-time">{readingTime}</span>
              </>
            )
          }
        </div>

        <!-- 阅读箭头 -->
        {
          !isCompact && (
            <div class="story-card-arrow" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <path
                  d="M3 8H13M13 8L9 4M13 8L9 12"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          )
        }
      </div>

      <!-- 标签（紧凑模式） -->
      {
        isCompact && tags.length > 0 && (
          <div class="story-card-tags">
            {tags.slice(0, 3).map((tag) => (
              <Tag label={tag} />
            ))}
          </div>
        )
      }
    </div>
  </a>
</article>

<style>
  /* ═══════════════════════════════════
     基础卡片
     Frontend Artisan: 玻璃态 + 精致边框 + 暖色调
     ═══════════════════════════════════ */
  .story-card {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 250ms ease,
      border-color 200ms ease;
    height: 100%;
    /* 微妙的内部光晕 */
    box-shadow:
      var(--shadow-xs),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .dark .story-card {
    box-shadow:
      var(--shadow-xs),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .story-card:hover {
    transform: translateY(-4px);
    box-shadow:
      var(--shadow-card-hover),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    border-color: var(--border-strong);
  }

  .dark .story-card:hover {
    box-shadow:
      var(--shadow-card-hover),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    border-color: var(--border-strong);
  }

  .story-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* ═══════════════════════════════════
     封面区
     ═══════════════════════════════════ */
  .story-card-cover {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--bg-muted);
    flex-shrink: 0;
  }

  .story-card--featured .story-card-cover {
    aspect-ratio: 16 / 9;
  }

  .story-card--horizontal .story-card-cover {
    aspect-ratio: 1 / 1;
    width: 200px;
    flex-shrink: 0;
  }

  .story-card-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .story-card:hover .story-card-cover-img {
    transform: scale(1.06);
  }

  /* 封面悬停遮罩 */
  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(26, 22, 20, 0.15) 100%);
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .story-card:hover .cover-overlay {
    opacity: 1;
  }

  /* 占位符 */
  .story-card-cover-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-brand-muted) 0%, var(--bg-muted) 100%);
    overflow: hidden;
  }

  /* 装饰性网格图案 */
  .placeholder-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        circle at 20% 30%,
        var(--placeholder-color, rgba(194, 98, 10, 0.2)) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 70%,
        var(--placeholder-color, rgba(194, 98, 10, 0.1)) 0%,
        transparent 50%
      );
  }

  .placeholder-letter {
    position: relative;
    font-size: 4rem;
    font-weight: 900;
    color: var(--color-brand);
    opacity: 0.15;
    letter-spacing: -0.05em;
    font-family: var(--font-display);
    z-index: 1;
    transition: transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .story-card:hover .placeholder-letter {
    transform: scale(1.15);
    opacity: 0.2;
  }

  /* 精选标签 */
  .story-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #e11d48, #be185d);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    box-shadow: 0 2px 8px rgba(225, 29, 72, 0.3);
  }

  /* ═══════════════════════════════════
     内容区
     ═══════════════════════════════════ */
  .story-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px;
    gap: 0;
  }

  .story-card--compact .story-card-body {
    padding: 16px;
  }

  .story-card--featured .story-card-body {
    padding: 24px;
  }

  /* 产品标签 */
  .story-card-products {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  .story-product-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand);
    background: var(--color-brand-muted);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(194, 98, 10, 0.2);
  }

  .dark .story-product-label {
    color: var(--color-brand-accent);
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.2);
  }

  /* 标题 */
  .story-card-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--text-primary);
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-fast);
    letter-spacing: -0.01em;
  }

  .story-card:hover .story-card-title {
    color: var(--color-brand);
  }

  .dark .story-card:hover .story-card-title {
    color: var(--color-brand-accent);
  }

  .story-card--featured .story-card-title {
    font-size: 1.3125rem;
    -webkit-line-clamp: 3;
    letter-spacing: -0.02em;
  }

  /* 描述 */
  .story-card-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 底部栏 */
  .story-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
    margin-top: 14px;
  }

  /* 元信息 */
  .story-card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .meta-sep {
    opacity: 0.4;
  }

  /* 阅读箭头 */
  .story-card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-muted);
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-spring),
      background var(--transition-fast),
      color var(--transition-fast);
    flex-shrink: 0;
  }

  .story-card:hover .story-card-arrow {
    opacity: 1;
    transform: translateX(0);
    background: var(--color-brand-muted);
    color: var(--color-brand);
  }

  .dark .story-card:hover .story-card-arrow {
    background: rgba(245, 158, 11, 0.1);
    color: var(--color-brand-accent);
  }

  /* 标签 */
  .story-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  /* ═══════════════════════════════════
     水平布局
     ═══════════════════════════════════ */
  .story-card--horizontal .story-card-link {
    flex-direction: row;
  }

  .story-card--horizontal .story-card-body {
    flex: 1;
  }

  @media (max-width: 480px) {
    .story-card--horizontal .story-card-link {
      flex-direction: column;
    }

    .story-card--horizontal .story-card-cover {
      width: 100%;
      aspect-ratio: 2 / 1;
    }
  }
</style>
