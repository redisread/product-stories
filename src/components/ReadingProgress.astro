---
// 阅读进度条组件（Islands 模式，client-side）
---

<div id="reading-progress" role="progressbar" aria-label="阅读进度" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

<script>
  const progressBar = document.getElementById('reading-progress') as HTMLElement;

  const updateProgress = () => {
    const article = document.getElementById('story-content');
    if (!article || !progressBar) return;

    const articleTop = article.offsetTop;
    const articleHeight = article.offsetHeight;
    const windowHeight = window.innerHeight;
    const scrolled = window.scrollY;

    const progress = Math.min(
      Math.max(((scrolled - articleTop) / (articleHeight - windowHeight)) * 100, 0),
      100
    );

    progressBar.style.width = `${progress}%`;
    progressBar.setAttribute('aria-valuenow', String(Math.round(progress)));
  };

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
